# EiSen Environment Configuration Template
# Copy this file to .env or .env.local to override initial runtime variables.
# These variables seed the FIRST-run config only: once a valid config.json is
# saved (Settings), it takes precedence and these are ignored.

# Custom directory to save captures by default (optional; built-in default is ~/Desktop)
# EISEN_SAVE_DIR=/Users/username/Pictures/EiSen

# Default UI Language: "En" or "Vi" (optional, defaults to "En")
# EISEN_DEFAULT_LANG=En

# Hotkey Preset: one of "DoubleOption", "DoubleShift", "CmdShift4Mac",
# "CtrlShift4Mac", "PrtScMac", "PrtScnWin" (optional; platform default applies)
# EISEN_HOTKEY_PRESET=CtrlShift4Mac
