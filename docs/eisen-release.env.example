# Copy to ~/.eisen-release.env (never commit that file).
#   cp docs/eisen-release.env.example ~/.eisen-release.env
#   chmod 600 ~/.eisen-release.env
#
# APPLE_CERTIFICATE / APPLE_CERTIFICATE_PASSWORD are CI-only (import the
# .p12 into your login keychain instead).

export APPLE_SIGNING_IDENTITY='Developer ID Application: Your Name (TEAMID)'
export APPLE_TEAM_ID='TEAMID10CH'
export APPLE_ID='you@example.com'
export APPLE_PASSWORD='app-specific-password-not-your-login'
