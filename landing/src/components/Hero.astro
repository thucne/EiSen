---
import type { Locale } from '../i18n/utils';
import { getDictionary, dmgDownloadPath, exeDownloadPath, githubUrl, microsoftStoreUrl } from '../i18n/utils';
import AppleIcon from './AppleIcon.astro';
import WindowsIcon from './WindowsIcon.astro';
import GithubIcon from './GithubIcon.astro';
import MacFirstNote from './MacFirstNote.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const dmgUrl = dmgDownloadPath;
const exeUrl = exeDownloadPath;
const winStoreUrl = microsoftStoreUrl;
const dmgBadge = locale === 'vi' ? '4,56 MB' : '4.56 MB';

const tools = [
  { label: 'Arrow', path: 'M5 19L19 5m0 0H9m10 0v10' },
  { label: 'Rectangle', path: 'M4 6h16v12H4z' },
  { label: 'Pen', path: 'M4 20l4-1L19 8a2 2 0 00-3-3L5 16l-1 4z' },
  { label: 'Crop', path: 'M7 3v14h14M3 7h14v14' },
];
---

<section class="pt-8 pb-12 sm:pt-14 sm:pb-20 lg:pt-20 lg:pb-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:grid-rows-[auto_1fr] gap-x-14 gap-y-7">
    <div class="lg:self-end">
      <h1
        id="hero-title"
        data-win-text={t.hero.titleWin}
        class="text-4xl sm:text-6xl lg:text-[3.5rem] xl:text-6xl font-bold tracking-tight text-zinc-50 leading-[1.08]"
      >
        {t.hero.title}
      </h1>
      <p id="hero-subtitle" data-win-text={t.hero.subtitleWin} class="mt-4 text-xl sm:text-2xl text-zinc-200 leading-snug">
        {t.hero.subtitle}
      </p>
      <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed">
        {t.hero.description}
      </p>
    </div>

    <!-- Comes right after the headline on phones, beside the text from lg up -->
    <figure class="lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
      <div class="rounded-2xl border border-white/10 bg-[#17181c] overflow-hidden shadow-2xl shadow-black/40">
        <div class="flex items-center gap-1.5 px-4 h-9 border-b border-white/10" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-600"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-600"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-600"></span>
          <span class="ml-2 text-xs text-zinc-400">EiSen</span>
        </div>

        <div class="relative aspect-[16/11] bg-[#1f2025] font-mono text-[11px] sm:text-sm text-zinc-300 p-4 sm:p-7 leading-7 sm:leading-9 overflow-hidden" aria-hidden="true">
          <p class="text-zinc-500"># {t.hero.demoFile}</p>
          <p>DATABASE_HOST=db.internal</p>
          <p class="flex items-center gap-2 whitespace-nowrap">
            <span>API_KEY=</span>
            <span class="inline-block h-5 sm:h-6 w-32 sm:w-52 rounded-[2px] bg-black"></span>
          </p>
          <p>REGION=ap-southeast-1</p>
          <p>LOG_LEVEL=info</p>

          <!-- Annotation: a numbered step pointing at the redacted value -->
          <div class="absolute right-[5%] top-[12%] flex items-center gap-2 font-sans">
            <span class="w-6 h-6 rounded-full bg-[#ff6b3d] text-zinc-950 font-bold text-xs flex items-center justify-center">1</span>
            <span class="text-[#ff8f6b] font-medium text-xs sm:text-sm">{t.hero.demoStep}</span>
          </div>
          <svg class="absolute inset-0 w-full h-full" viewBox="0 0 160 110" fill="none">
            <path d="M126 24 C 124 32, 116 37, 106 39" stroke="#ff6b3d" stroke-width="1.2" stroke-linecap="round" />
            <path d="M110.5 35.6 L106 39 L111 41.6" stroke="#ff6b3d" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>

          <!-- Floating thumbnail -->
          <div class="absolute right-[4%] bottom-[6%] w-[26%] aspect-[4/3] rounded-lg bg-zinc-200 p-1 shadow-lg shadow-black/60">
            <div class="h-full w-full rounded bg-[#26272d] p-1.5 space-y-1">
              <div class="h-1 w-3/4 rounded bg-zinc-500"></div>
              <div class="h-1 w-1/2 rounded bg-zinc-600"></div>
              <div class="h-2 w-2/3 rounded-[1px] bg-black"></div>
              <div class="h-1 w-3/5 rounded bg-zinc-600"></div>
            </div>
          </div>
        </div>

        <!-- Editor toolbar -->
        <div aria-hidden="true" class="flex items-center gap-1 px-2 sm:px-3 py-2 border-t border-white/10 text-zinc-300 text-xs overflow-hidden">
          {tools.map((tool) => (
            <span class="p-1.5 sm:p-2 rounded-md shrink-0" title={tool.label}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={tool.path} /></svg>
            </span>
          ))}
          <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-md bg-white/10 flex items-center justify-center shrink-0">
            <span class="w-4 h-3 rounded-[2px] bg-zinc-100"></span>
          </span>
          <span class="ml-auto flex items-center gap-1 shrink-0">
            <span class="px-2 py-1 rounded-md">OCR</span>
            <span class="px-2.5 py-1 rounded-md bg-zinc-100 text-zinc-900 font-medium">Copy</span>
          </span>
        </div>
      </div>
      <figcaption class="mt-3 text-xs text-zinc-500">{t.hero.demoCaption}</figcaption>
    </figure>

    <div class="lg:self-start">
      <!-- Phones can't run a DMG, so they get the link instead -->
      <div class="only-phone">
        <button
          type="button"
          data-copy-link
          data-copied-label={t.hero.copied}
          class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-zinc-100 text-zinc-900 font-semibold"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1" /></svg>
          <span data-copy-label>{t.hero.copyLink}</span>
        </button>
        <p class="mt-3 text-sm text-zinc-400">{t.hero.phoneNote}</p>
      </div>

      <div class="not-phone flex flex-col sm:flex-row sm:items-center gap-3">
        <a
          id="hero-download-btn"
          href={dmgUrl}
          data-mac-url={dmgUrl}
          data-win-url={winStoreUrl}
          data-win-direct-url={exeUrl}
          data-mac-label={t.hero.downloadMac}
          data-win-label={t.hero.downloadWin}
          data-switch-to-win={t.hero.switchToWin}
          data-switch-to-mac={t.hero.switchToMac}
          class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-zinc-100 hover:bg-white text-zinc-900 font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-100 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0f1015]"
        >
          <span id="hero-mac-icon"><AppleIcon class="w-5 h-5 shrink-0" size={20} /></span>
          <span id="hero-win-icon" class="hidden"><WindowsIcon class="w-5 h-5 shrink-0" size={20} /></span>
          <span id="hero-download-text">{t.hero.downloadMac}</span>
          <span id="hero-download-badge" class="text-sm font-normal text-zinc-600">{dmgBadge}</span>
        </a>

        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 px-5 py-3.5 rounded-xl border border-white/15 hover:border-white/30 text-zinc-200 hover:text-white font-medium transition-colors"
        >
          <GithubIcon class="w-5 h-5 shrink-0" size={20} />
          <span>{t.hero.githubCta}</span>
        </a>
      </div>

      <p id="hero-requirements" class="not-phone mt-3 text-sm text-zinc-400">{t.hero.requirements}</p>

      <div class="not-phone mt-2">
        <a
          id="hero-os-switch-link"
          href={exeUrl}
          class="text-sm text-zinc-300 hover:text-white underline underline-offset-4 decoration-zinc-600 transition-colors"
        >
          <span id="hero-switch-text">{t.hero.switchToWin}</span>
        </a>
      </div>

      <!-- Shown only when Windows is selected or detected -->
      <div id="hero-windows-note" class="hidden mt-4 space-y-3">
        <p class="text-sm text-zinc-300 leading-relaxed">{t.hero.windowsNote}</p>
        <MacFirstNote locale={locale} />
      </div>

      <div
        id="hero-windows-warning"
        role="note"
        aria-hidden="true"
        class="hidden mt-4 rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 text-xs sm:text-sm text-amber-100 leading-relaxed"
      >
        {t.hero.windowsWarning}
      </div>

      <div id="hero-windows-fallback" aria-hidden="true" class="hidden mt-3">
        <a
          href={exeUrl}
          class="text-xs text-amber-200/90 hover:text-amber-100 underline underline-offset-4 decoration-amber-300/40 transition-colors"
        >
          {t.hero.windowsFallback}
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    try {
      const isWin = navigator.userAgent.toLowerCase().includes('windows');

      const btn = document.getElementById('hero-download-btn');
      const macIcon = document.getElementById('hero-mac-icon');
      const winIcon = document.getElementById('hero-win-icon');
      const text = document.getElementById('hero-download-text');
      const badge = document.getElementById('hero-download-badge');
      const requirements = document.getElementById('hero-requirements');
      const switchLink = document.getElementById('hero-os-switch-link');
      const switchText = document.getElementById('hero-switch-text');
      const windowsNote = document.getElementById('hero-windows-note');
      const windowsWarning = document.getElementById('hero-windows-warning');
      const windowsFallback = document.getElementById('hero-windows-fallback');
      const title = document.getElementById('hero-title');
      const subtitle = document.getElementById('hero-subtitle');
      const macTitle = title?.textContent.trim();
      const macSubtitle = subtitle?.textContent.trim();

      let currentOS = isWin ? 'win' : 'mac';

      function applyOS(os) {
        currentOS = os;
        if (os === 'win') {
          if (btn && btn.dataset.winUrl) btn.href = btn.dataset.winUrl;
          if (btn) {
            btn.target = '_blank';
            btn.rel = 'noopener noreferrer';
          }
          if (macIcon) macIcon.classList.add('hidden');
          if (winIcon) winIcon.classList.remove('hidden');
          if (text) text.textContent = btn?.dataset.winLabel || 'Get from Microsoft Store';
          if (badge) badge.classList.add('hidden');
          if (requirements) requirements.classList.add('hidden');
          if (title && title.dataset.winText) title.textContent = title.dataset.winText;
          if (subtitle && subtitle.dataset.winText) subtitle.textContent = subtitle.dataset.winText;
          if (switchLink && btn) switchLink.href = btn.dataset.macUrl || '#';
          if (switchText) switchText.textContent = btn?.dataset.switchToMac || 'On a Mac? Download EiSen 1.0';
          if (windowsNote) windowsNote.classList.remove('hidden');
          if (windowsWarning) {
            windowsWarning.classList.remove('hidden');
            windowsWarning.setAttribute('aria-hidden', 'false');
          }
          if (windowsFallback) {
            windowsFallback.classList.remove('hidden');
            windowsFallback.setAttribute('aria-hidden', 'false');
          }
        } else {
          if (btn && btn.dataset.macUrl) btn.href = btn.dataset.macUrl;
          if (btn) {
            btn.removeAttribute('target');
            btn.removeAttribute('rel');
          }
          if (macIcon) macIcon.classList.remove('hidden');
          if (winIcon) winIcon.classList.add('hidden');
          if (text) text.textContent = btn?.dataset.macLabel || 'Download for Mac';
          if (badge) badge.classList.remove('hidden');
          if (requirements) requirements.classList.remove('hidden');
          if (title && macTitle) title.textContent = macTitle;
          if (subtitle && macSubtitle) subtitle.textContent = macSubtitle;
          if (switchLink && btn) switchLink.href = btn.dataset.winDirectUrl || btn.dataset.winUrl || '#';
          if (switchText) switchText.textContent = btn?.dataset.switchToWin || 'On Windows? Get EiSen 0.2 from the Microsoft Store';
          if (windowsNote) windowsNote.classList.add('hidden');
          if (windowsWarning) {
            windowsWarning.classList.add('hidden');
            windowsWarning.setAttribute('aria-hidden', 'true');
          }
          if (windowsFallback) {
            windowsFallback.classList.add('hidden');
            windowsFallback.setAttribute('aria-hidden', 'true');
          }
        }
      }

      switchLink?.addEventListener('click', (e) => {
        e.preventDefault();
        applyOS(currentOS === 'mac' ? 'win' : 'mac');
      });

      if (isWin) {
        applyOS('win');
      }
    } catch {}
  })();
</script>
