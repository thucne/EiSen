---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.faq;
---

<section id="faq" class="py-16 sm:py-24 border-t border-white/10 scroll-mt-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-50">{f.title}</h2>

    <div class="mt-8 sm:mt-12 divide-y divide-white/10 border-y border-white/10">
      {f.items.map((item) => (
        <details class="group py-4 sm:py-5">
          <summary class="flex items-center justify-between cursor-pointer font-medium text-zinc-100 list-none select-none focus:outline-none focus-visible:underline">
            <span>{item.q}</span>
            <span class="ml-4 text-zinc-500 group-open:rotate-180 transition-transform duration-200 flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="mt-3 text-zinc-400 leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
