---
import type { Locale } from '../i18n/utils';
import { getDictionary, dmgDownloadPath } from '../i18n/utils';
import AppleIcon from './AppleIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const d = t.downloadSection;

const dmgUrl = dmgDownloadPath;
const releasesUrl = 'https://github.com/thucne/EiSen/releases';
---

<section id="download" class="py-24 relative overflow-hidden">
  <!-- Glowing background gradient -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
    <div class="w-[600px] h-[350px] bg-gradient-to-r from-indigo-600/20 via-purple-600/20 to-cyan-600/20 blur-[130px] rounded-full"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="p-8 sm:p-14 rounded-3xl bg-[#161822]/80 border border-white/15 shadow-2xl backdrop-blur-2xl">
      <!-- Icon & Wordmark -->
      <div class="flex flex-col items-center gap-3 mb-6">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 p-[2px] shadow-xl shadow-indigo-500/30">
          <div class="w-full h-full bg-[#12141d] rounded-[14px] flex items-center justify-center p-3">
            <img src="/brand/eisen-mark-reversed.svg" alt="EiSen" class="w-full h-full object-contain" width="40" height="40" />
          </div>
        </div>
        <img src="/brand/eisen-wordmark-reversed.svg" alt="EiSen" class="h-6 w-auto object-contain" width="120" height="40" />
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        {d.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8">
        {d.subtitle}
      </p>

      <!-- Main Action Button -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={dmgUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-indigo-500 via-indigo-600 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-bold text-base sm:text-lg shadow-xl shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
        >
          <AppleIcon class="w-6 h-6" size={24} />
          <span>{d.button}</span>
        </a>

        <a
          href={releasesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 text-slate-200 hover:text-white font-medium text-base transition-all duration-200"
        >
          <span>{d.viewGithub}</span>
          <span>→</span>
        </a>
      </div>

      <div class="mt-6 space-y-2">
        <p class="text-xs text-slate-400 font-mono font-medium">
          {d.details}
        </p>
        <p class="text-[11px] text-slate-400 font-mono select-all bg-black/40 py-1.5 px-3 rounded-lg inline-block border border-white/5">
          {d.checksum}
        </p>
      </div>
    </div>
  </div>
</section>
