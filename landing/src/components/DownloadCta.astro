---
import type { Locale } from '../i18n/utils';
import { getDictionary, dmgDownloadPath, exeDownloadPath, microsoftStoreUrl, releasesUrl } from '../i18n/utils';
import AppleIcon from './AppleIcon.astro';
import WindowsIcon from './WindowsIcon.astro';
import MacFirstNote from './MacFirstNote.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const d = t.downloadSection;

const dmgUrl = dmgDownloadPath;
const exeUrl = exeDownloadPath;
---

<section id="download" class="py-16 sm:py-24 border-t border-white/10 scroll-mt-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <img src="/brand/eisen-mark-reversed.svg" alt="" class="h-12 w-auto" width="48" height="48" />
    <h2 class="mt-5 text-3xl sm:text-5xl font-bold tracking-tight text-zinc-50">{d.title}</h2>
    <p class="mt-3 text-lg text-zinc-400">{d.subtitle}</p>

    <button
      type="button"
      data-copy-link
      data-copied-label={d.copied}
      class="only-phone mt-7 w-full px-6 py-3.5 rounded-xl bg-zinc-100 text-zinc-900 font-semibold"
    >
      <span data-copy-label>{d.copyLink}</span>
    </button>

    <div class="not-phone mt-7">
      <a
        id="cta-mac-btn"
        href={dmgUrl}
        class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-zinc-100 hover:bg-white text-zinc-900 font-semibold transition-colors"
      >
        <AppleIcon class="w-5 h-5 shrink-0" size={20} />
        <span>{d.buttonMac}</span>
      </a>
      <p class="mt-3 text-sm text-zinc-400">{d.detailsMac}</p>
    </div>

    <details id="cta-windows" class="mt-8 border-t border-white/10 pt-5 group">
      <summary class="cursor-pointer text-sm text-zinc-300 hover:text-white list-none flex items-center gap-2">
        <WindowsIcon class="w-4 h-4 shrink-0" size={16} />
        <span class="underline underline-offset-4 decoration-zinc-600">{d.windowsSummary}</span>
      </summary>

      <div class="mt-4 space-y-3">
        <MacFirstNote locale={locale} />
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            id="cta-win-store-btn"
            href={microsoftStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-white/20 hover:border-white/40 text-zinc-100 font-medium text-sm transition-colors"
          >
            <WindowsIcon class="w-4 h-4 shrink-0" size={16} />
            <span>{d.buttonWin}</span>
          </a>
          <a
            id="cta-win-direct-btn"
            href={exeUrl}
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-amber-400/30 hover:border-amber-400/60 text-amber-200 font-medium text-sm transition-colors"
          >
            <span>{d.buttonWinDirect}</span>
          </a>
        </div>
        <p class="text-sm text-zinc-400">{d.detailsWin}</p>
        <div role="note" class="rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 text-sm text-amber-100">
          <p class="font-semibold text-amber-200">{d.windowsWarningTitle}</p>
          <p class="mt-1 leading-relaxed">{d.windowsWarning}</p>
        </div>
      </div>
    </details>

    <a href={releasesUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block text-sm text-zinc-300 underline underline-offset-4 decoration-zinc-600 hover:text-white">
      {d.viewGithub} →
    </a>
  </div>
</section>

<script is:inline>
  (() => {
    try {
      if (navigator.userAgent.toLowerCase().includes('windows')) {
        const windows = document.getElementById('cta-windows');
        if (windows) windows.open = true;
      }
    } catch {}
  })();
</script>
