---
import type { Locale } from '../i18n/utils';
import { getDictionary, dmgDownloadPath, exeDownloadPath, microsoftStoreUrl, releasesUrl } from '../i18n/utils';
import AppleIcon from './AppleIcon.astro';
import WindowsIcon from './WindowsIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const d = t.downloadSection;

const dmgUrl = dmgDownloadPath;
const exeUrl = exeDownloadPath;
---

<section id="download" class="py-24 relative overflow-hidden">
  <!-- Glowing background gradient -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
    <div class="w-[600px] h-[350px] bg-gradient-to-r from-indigo-600/20 via-purple-600/20 to-cyan-600/20 blur-[130px] rounded-full"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="p-6 sm:p-14 rounded-3xl bg-[#161822]/80 border border-white/15 shadow-2xl backdrop-blur-2xl">
      <!-- Icon & Wordmark -->
      <div class="flex flex-col items-center gap-3 mb-6">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 p-[2px] shadow-xl shadow-indigo-500/30">
          <div class="w-full h-full bg-[#12141d] rounded-[14px] flex items-center justify-center p-2.5 sm:p-3">
            <img src="/brand/eisen-mark-reversed.svg" alt="EiSen" class="w-full h-full object-contain" width="40" height="40" />
          </div>
        </div>
        <img src="/brand/eisen-wordmark-reversed.svg" alt="EiSen" class="h-5 sm:h-6 w-auto object-contain" width="120" height="40" />
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        {d.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8">
        {d.subtitle}
      </p>

      <!-- Action Buttons for macOS and Windows -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <!-- macOS Download Button -->
        <a
          id="cta-mac-btn"
          href={dmgUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl bg-gradient-to-r from-indigo-500 via-indigo-600 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-bold text-base shadow-xl shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
        >
          <AppleIcon class="w-5 h-5 shrink-0" size={20} />
          <span>{d.buttonMac}</span>
        </a>

        <!-- Windows Microsoft Store Button -->
        <a
          id="cta-win-store-btn"
          href={microsoftStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white font-bold text-base shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
        >
          <WindowsIcon class="w-5 h-5 shrink-0" size={20} />
          <span>{d.buttonWin}</span>
        </a>

        <!-- Direct Windows fallback -->
        <a
          id="cta-win-direct-btn"
          href={exeUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-amber-400/25 text-amber-100 hover:text-white font-medium text-sm sm:text-base transition-all duration-200"
        >
          <WindowsIcon class="w-4 h-4 shrink-0 text-amber-300" size={18} />
          <span>{d.buttonWinDirect}</span>
        </a>

        <!-- GitHub Releases Button -->
        <a
          href={releasesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 sm:py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 text-slate-200 hover:text-white font-medium text-base transition-all duration-200"
        >
          <span>{d.viewGithub}</span>
          <span>→</span>
        </a>
      </div>

      <div class="mt-8 pt-6 border-t border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-3 text-left max-w-xl mx-auto text-xs text-slate-400 font-mono">
        <div class="p-3 rounded-xl bg-white/5 border border-white/5">
          <p class="font-semibold text-slate-300 flex items-center gap-1.5 mb-1">
            <AppleIcon class="w-3.5 h-3.5" size={14} />
            <span>macOS</span>
          </p>
          <p>{d.detailsMac}</p>
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/5">
          <p class="font-semibold text-slate-300 flex items-center gap-1.5 mb-1">
            <WindowsIcon class="w-3.5 h-3.5 text-cyan-400" size={14} />
            <span>Windows</span>
          </p>
          <p>{d.detailsWin}</p>
        </div>
      </div>

      <div role="note" class="mt-4 mx-auto max-w-2xl rounded-xl border border-amber-400/30 bg-amber-400/10 p-4 text-left text-sm text-amber-100">
        <p class="font-semibold text-amber-200">{d.windowsWarningTitle}</p>
        <p class="mt-1 leading-relaxed">{d.windowsWarning}</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    try {
      const isWin = navigator.userAgent.toLowerCase().includes('windows');
      if (isWin) {
        // Swap visual prominence if on Windows
        const macBtn = document.getElementById('cta-mac-btn');
        const winBtn = document.getElementById('cta-win-store-btn');
        if (macBtn && winBtn && winBtn.parentNode) {
          winBtn.parentNode.insertBefore(winBtn, macBtn);
        }
      }
    } catch {}
  })();
</script>
