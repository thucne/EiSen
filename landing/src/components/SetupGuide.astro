---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const s = t.setup;
---

<section id="setup" class="py-16 sm:py-24 border-t border-white/10 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-50">{s.title}</h2>

    <ol class="mt-10 sm:mt-14 grid md:grid-cols-3 gap-8 md:gap-10">
      <li>
        <span class="font-mono text-sm text-zinc-500">1</span>
        <h3 class="mt-2 text-lg font-semibold text-zinc-50">{s.step1Title}</h3>
        <p class="mt-2 text-zinc-400 leading-relaxed">{s.step1Desc}</p>
        <p class="mt-3 font-mono text-xs text-zinc-500">macOS: /Applications/EiSen.app</p>
      </li>
      <li>
        <span class="font-mono text-sm text-zinc-500">2</span>
        <h3 class="mt-2 text-lg font-semibold text-zinc-50">{s.step2Title}</h3>
        <p class="mt-2 text-zinc-400 leading-relaxed">{s.step2Desc}</p>
        <p class="mt-3 font-mono text-xs text-zinc-500">macOS: Privacy &amp; Security → Screen Recording</p>
      </li>
      <li>
        <span class="font-mono text-sm text-zinc-500">3</span>
        <h3 class="mt-2 text-lg font-semibold text-zinc-50">{s.step3Title}</h3>
        <p class="mt-2 text-zinc-400 leading-relaxed">{s.step3Desc}</p>
        <p class="mt-3 font-mono text-xs text-zinc-500">macOS: Default: ⌥⌥ (Double Option)</p>
      </li>
    </ol>
  </div>
</section>
