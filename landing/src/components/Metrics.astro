---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="py-8 sm:py-12 border-y border-white/10 bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
      <!-- 100% Local -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-indigo-500/30 transition-colors">
        <div class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">
          {t.metrics.local.value}
        </div>
        <div class="text-sm font-semibold text-white mt-1">
          {t.metrics.local.label}
        </div>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          {t.metrics.local.sub}
        </p>
      </div>

      <!-- Latency -->
      <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-indigo-500/30 transition-colors">
        <div class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">
          {t.metrics.latency.value}
        </div>
        <div class="text-sm font-semibold text-white mt-1">
          {t.metrics.latency.label}
        </div>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          {t.metrics.latency.sub}
        </p>
      </div>

      <!-- Apple Vision -->
      <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-indigo-500/30 transition-colors">
        <div class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">
          {t.metrics.ocr.value}
        </div>
        <div class="text-sm font-semibold text-white mt-1">
          {t.metrics.ocr.label}
        </div>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          {t.metrics.ocr.sub}
        </p>
      </div>

      <!-- Menu Bar Only -->
      <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-indigo-500/30 transition-colors">
        <div class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">
          {t.metrics.tray.value}
        </div>
        <div class="text-sm font-semibold text-white mt-1">
          {t.metrics.tray.label}
        </div>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          {t.metrics.tray.sub}
        </p>
      </div>
    </div>
  </div>
</section>
