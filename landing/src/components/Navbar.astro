---
import type { Locale } from '../i18n/utils';
import { getDictionary, getLocalizedPath, dmgDownloadPath, githubUrl, microsoftStoreUrl } from '../i18n/utils';
import AppleIcon from './AppleIcon.astro';
import WindowsIcon from './WindowsIcon.astro';
import GithubIcon from './GithubIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const currentPath = Astro.url.pathname;
const targetLocale: Locale = locale === 'en' ? 'vi' : 'en';
// The CleanShot page is English only, so its switch goes to the Vietnamese home page.
const switchPath = currentPath.startsWith('/cleanshot-alternative') ? '/vi/' : getLocalizedPath(currentPath, targetLocale);

const homePath = locale === 'vi' ? '/vi/' : '/';
const windowsPath = locale === 'vi' ? '/vi/windows' : '/windows';
const changelogPath = locale === 'vi' ? '/vi/changelog' : '/changelog';
---

<header class="sticky top-0 z-50 w-full bg-[#0f1015] border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-4">
    <a href={homePath} class="rounded-lg shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-300">
      <img
        src="/brand/eisen-horizontal-reversed.svg"
        alt="EiSen"
        class="h-7 sm:h-8 w-auto object-contain"
        width="144"
        height="54"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-sm text-zinc-300 whitespace-nowrap">
      <a href={`${homePath}#features`} class="hover:text-white transition-colors">{t.nav.features}</a>
      <a href={`${homePath}#comparison`} class="hover:text-white transition-colors">{t.nav.comparison}</a>
      <a href={changelogPath} class="hover:text-white transition-colors">{t.nav.changelog}</a>
      <a href={`${homePath}#faq`} class="hover:text-white transition-colors">{t.nav.faq}</a>
      <a href={windowsPath} class="hover:text-white transition-colors">{t.nav.windows}</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5">
        <GithubIcon class="w-4 h-4" size={16} />
        <span>{t.nav.github}</span>
      </a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href={switchPath}
        class="px-2 py-1.5 rounded-lg text-xs font-medium tracking-wide text-zinc-300 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-300"
        title={locale === 'en' ? 'Chuyển sang Tiếng Việt' : 'Switch to English'}
      >
        {locale === 'en' ? 'VI' : 'EN'}
      </a>

      <button
        type="button"
        data-copy-link
        data-copied-label={t.nav.copied}
        class="only-phone px-3 py-1.5 rounded-lg bg-zinc-100 text-zinc-900 text-sm font-semibold whitespace-nowrap"
      >
        <span data-copy-label>{t.nav.copyLink}</span>
      </button>

      <a
        id="navbar-download-btn"
        href={dmgDownloadPath}
        data-mac-url={dmgDownloadPath}
        data-win-url={microsoftStoreUrl}
        data-mac-label={t.nav.downloadMac}
        data-win-label={t.nav.downloadWin}
        class="not-phone inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg bg-zinc-100 hover:bg-white text-zinc-900 text-sm font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-100 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0f1015] whitespace-nowrap"
      >
        <span id="navbar-apple-icon"><AppleIcon class="w-4 h-4 shrink-0" size={16} /></span>
        <span id="navbar-win-icon" class="hidden"><WindowsIcon class="w-4 h-4 shrink-0" size={16} /></span>
        <span id="navbar-download-text">{t.nav.download}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    try {
      const isWin = navigator.userAgent.toLowerCase().includes('windows');
      if (isWin) {
        const btn = document.getElementById('navbar-download-btn');
        const appleIcon = document.getElementById('navbar-apple-icon');
        const winIcon = document.getElementById('navbar-win-icon');
        if (btn && btn.dataset.winUrl) {
          btn.href = btn.dataset.winUrl;
          btn.target = '_blank';
          btn.rel = 'noopener noreferrer';
        }
        if (appleIcon) appleIcon.classList.add('hidden');
        if (winIcon) winIcon.classList.remove('hidden');
        const text = document.getElementById('navbar-download-text');
        if (text) text.textContent = btn?.dataset.winLabel || 'Microsoft Store';
      }
    } catch {}
  })();
</script>
