---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.features;
---

<section id="features" class="py-14 sm:py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-3 sm:space-y-4">
      <div class="text-xs font-bold tracking-widest text-indigo-400 uppercase font-mono">
        {f.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        {f.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        {f.subtitle}
      </p>
    </div>

    <!-- Feature Cards Grid (3x2) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
      <!-- 1. Smart Crop & Shortcuts -->
      <div class="relative group p-5 sm:p-8 rounded-2xl bg-[#161822]/90 border border-white/10 hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/10 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <span class="text-xs font-mono font-semibold text-indigo-400 tracking-wider uppercase">{f.crop.tag}</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-3">{f.crop.title}</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">{f.crop.description}</p>
        </div>
        <ul class="space-y-2 border-t border-white/5 pt-4 text-xs text-slate-400 font-medium">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.crop.bullet1}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.crop.bullet2}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.crop.bullet3}</span>
          </li>
        </ul>
      </div>

      <!-- 2. Annotation Suite -->
      <div class="relative group p-5 sm:p-8 rounded-2xl bg-[#161822]/90 border border-white/10 hover:border-purple-500/50 hover:shadow-xl hover:shadow-purple-500/10 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          </div>
          <span class="text-xs font-mono font-semibold text-purple-400 tracking-wider uppercase">{f.annotate.tag}</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-3">{f.annotate.title}</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">{f.annotate.description}</p>
        </div>
        <ul class="space-y-2 border-t border-white/5 pt-4 text-xs text-slate-400 font-medium">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.annotate.bullet1}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.annotate.bullet2}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.annotate.bullet3}</span>
          </li>
        </ul>
      </div>

      <!-- 3. Redaction & Privacy Blur -->
      <div class="relative group p-5 sm:p-8 rounded-2xl bg-[#161822]/90 border border-white/10 hover:border-red-500/50 hover:shadow-xl hover:shadow-red-500/10 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-red-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <span class="text-xs font-mono font-semibold text-red-400 tracking-wider uppercase">{f.redact.tag}</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-3">{f.redact.title}</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">{f.redact.description}</p>
        </div>
        <ul class="space-y-2 border-t border-white/5 pt-4 text-xs text-slate-400 font-medium">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.redact.bullet1}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.redact.bullet2}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.redact.bullet3}</span>
          </li>
        </ul>
      </div>

      <!-- 4. On-Device OCR with Apple Vision -->
      <div class="relative group p-5 sm:p-8 rounded-2xl bg-[#161822]/90 border border-white/10 hover:border-cyan-500/50 hover:shadow-xl hover:shadow-cyan-500/10 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <span class="text-xs font-mono font-semibold text-cyan-400 tracking-wider uppercase">{f.ocr.tag}</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-3">{f.ocr.title}</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">{f.ocr.description}</p>
        </div>
        <ul class="space-y-2 border-t border-white/5 pt-4 text-xs text-slate-400 font-medium">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.ocr.bullet1}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.ocr.bullet2}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.ocr.bullet3}</span>
          </li>
        </ul>
      </div>

      <!-- 5. Eyedropper Loupe -->
      <div class="relative group p-5 sm:p-8 rounded-2xl bg-[#161822]/90 border border-white/10 hover:border-emerald-500/50 hover:shadow-xl hover:shadow-emerald-500/10 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 4.001 4.001 0 015.426-3.738l8.288-8.288a2 2 0 112.828 2.828l-8.288 8.288A4.001 4.001 0 017 21z"/></svg>
          </div>
          <span class="text-xs font-mono font-semibold text-emerald-400 tracking-wider uppercase">{f.loupe.tag}</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-3">{f.loupe.title}</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">{f.loupe.description}</p>
        </div>
        <ul class="space-y-2 border-t border-white/5 pt-4 text-xs text-slate-400 font-medium">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.loupe.bullet1}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.loupe.bullet2}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.loupe.bullet3}</span>
          </li>
        </ul>
      </div>

      <!-- 6. Session History & Menu Bar Hub -->
      <div class="relative group p-5 sm:p-8 rounded-2xl bg-[#161822]/90 border border-white/10 hover:border-amber-500/50 hover:shadow-xl hover:shadow-amber-500/10 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <span class="text-xs font-mono font-semibold text-amber-400 tracking-wider uppercase">{f.history.tag}</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-3">{f.history.title}</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">{f.history.description}</p>
        </div>
        <ul class="space-y-2 border-t border-white/5 pt-4 text-xs text-slate-400 font-medium">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.history.bullet1}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.history.bullet2}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>{f.history.bullet3}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
