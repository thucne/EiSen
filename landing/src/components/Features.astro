---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const f = getDictionary(locale).features;

const tagClass = 'inline-block font-mono text-xs text-zinc-400 border border-white/15 rounded px-1.5 py-0.5';
const stageClass = 'relative aspect-[16/10] overflow-hidden rounded-xl border border-white/10 bg-[#1a1b20]';
---

<section id="features" class="py-16 sm:py-24 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="max-w-3xl text-3xl sm:text-5xl font-bold tracking-tight text-zinc-50">{f.title}</h2>

    <!-- Each figure carries data-video-slot, where a real recording replaces the illustration later. -->
    <div class="mt-12 sm:mt-20 space-y-16 sm:space-y-24">
      <!-- Redact -->
      <article class="grid lg:grid-cols-2 gap-6 lg:gap-14 items-center">
        <div>
          <span class={tagClass}>{f.bothPlatforms}</span>
          <h3 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-50">{f.redact.title}</h3>
          <p class="mt-3 text-zinc-300 leading-relaxed">{f.redact.description}</p>
        </div>
        <figure data-video-slot="redact" role="img" aria-label={f.redact.demoLabel} class={stageClass}>
          <div class="absolute inset-0 flex flex-col justify-center p-5 sm:p-8 font-mono text-xs sm:text-sm text-zinc-400 leading-8 sm:leading-9">
            <p>DATABASE_HOST=db.internal</p>
            <p class="flex items-center gap-2 whitespace-nowrap">
              <span>API_KEY=</span>
              <span class="inline-block h-5 sm:h-6 w-40 sm:w-56 max-w-[55%] rounded-[2px] bg-black" aria-hidden="true"></span>
            </p>
            <p>REGION=ap-southeast-1</p>
            <p class="flex items-center gap-2 whitespace-nowrap">
              <span>PASSWORD=</span>
              <span class="inline-block h-5 sm:h-6 w-28 sm:w-40 rounded-[2px] bg-black" aria-hidden="true"></span>
            </p>
            <p>LOG_LEVEL=info</p>
          </div>
        </figure>
      </article>

      <!-- Floating thumbnail -->
      <article class="grid lg:grid-cols-2 gap-6 lg:gap-14 items-center">
        <div class="lg:order-2">
          <span class={tagClass}>{f.macOnly}</span>
          <h3 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-50">{f.thumbnail.title}</h3>
          <p class="mt-3 text-zinc-300 leading-relaxed">{f.thumbnail.description}</p>
        </div>
        <figure data-video-slot="thumbnail" role="img" aria-label={f.thumbnail.demoLabel} class:list={[stageClass, 'lg:order-1']}>
          <div class="absolute left-[8%] top-[12%] w-[52%] space-y-2.5" aria-hidden="true">
            <div class="ml-auto w-fit max-w-full rounded-xl rounded-br-sm bg-zinc-700 px-3 py-1.5 text-xs sm:text-sm text-zinc-100">{f.thumbnail.demoMessage}</div>
            <div class="h-16 sm:h-24 rounded-lg border border-dashed border-white/25"></div>
          </div>
          <svg class="absolute inset-0 w-full h-full" viewBox="0 0 160 100" fill="none" aria-hidden="true">
            <path d="M126 76 C 112 74, 104 62, 92 52" stroke="#ff6b3d" stroke-width="1.1" stroke-linecap="round" stroke-dasharray="2.4 2.4" />
            <path d="M97 51.5 L92 52 L93.5 56.6" stroke="#ff6b3d" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div class="absolute right-[5%] bottom-[8%] w-[28%] aspect-[4/3] rounded-lg bg-zinc-200 p-1 shadow-lg shadow-black/50 rotate-[-2deg]" aria-hidden="true">
            <div class="h-full w-full rounded bg-[#26272d] p-1.5 space-y-1">
              <div class="h-1 w-3/4 rounded bg-zinc-500"></div>
              <div class="h-1 w-1/2 rounded bg-zinc-600"></div>
              <div class="h-2 w-2/3 rounded-[1px] bg-black"></div>
              <div class="h-1 w-3/5 rounded bg-zinc-600"></div>
            </div>
          </div>
        </figure>
      </article>

      <!-- Capture previous region -->
      <article class="grid lg:grid-cols-2 gap-6 lg:gap-14 items-center">
        <div>
          <span class={tagClass}>{f.macOnly}</span>
          <h3 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-50">{f.previous.title}</h3>
          <p class="mt-3 text-zinc-300 leading-relaxed">{f.previous.description}</p>
        </div>
        <figure data-video-slot="previous-region" role="img" aria-label={f.previous.demoLabel} class={stageClass}>
          <div class="absolute inset-[6%] grid grid-cols-3 gap-2 opacity-60" aria-hidden="true">
            {[0, 1, 2, 3, 4, 5].map(() => <div class="rounded bg-zinc-700/50"></div>)}
          </div>
          <div class="absolute left-[24%] top-[20%] w-[52%] h-[48%] border-2 border-[#ff6b3d] shadow-[0_0_0_999px_rgba(0,0,0,0.55)]" aria-hidden="true"></div>
          <div class="absolute bottom-[8%] left-1/2 -translate-x-1/2 flex items-center gap-1 font-mono text-xs sm:text-sm text-zinc-100" aria-hidden="true">
            <kbd class="rounded border border-white/25 bg-zinc-800 px-2 py-1">Ctrl</kbd>
            <kbd class="rounded border border-white/25 bg-zinc-800 px-2 py-1">Shift</kbd>
            <kbd class="rounded border border-white/25 bg-zinc-800 px-2 py-1">2</kbd>
          </div>
        </figure>
      </article>

      <!-- OCR -->
      <article class="grid lg:grid-cols-2 gap-6 lg:gap-14 items-center">
        <div class="lg:order-2">
          <span class={tagClass}>{f.bothPlatforms}</span>
          <h3 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-50">{f.ocr.title}</h3>
          <p class="mt-3 text-zinc-300 leading-relaxed">{f.ocr.description}</p>
        </div>
        <figure data-video-slot="ocr" role="img" aria-label={f.ocr.demoLabel} class:list={[stageClass, 'lg:order-1']}>
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 px-4" aria-hidden="true">
            <div class="border-2 border-[#ff6b3d] px-3 py-2 sm:px-5 sm:py-3 font-mono text-xs sm:text-base text-zinc-100 whitespace-nowrap">
              {f.ocr.demoText}
            </div>
            <div class="flex items-center gap-2 rounded-lg bg-zinc-100 px-3 py-1.5 text-xs sm:text-sm font-medium text-zinc-900">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>OCR • {f.ocr.demoCopied}</span>
            </div>
          </div>
        </figure>
      </article>
    </div>

    <!-- The rest of the tool, without a card for each item -->
    <div class="mt-16 sm:mt-24 pt-10 border-t border-white/10">
      <h3 class="text-xl font-semibold text-zinc-50">{f.moreTitle}</h3>
      <dl class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-5">
        {f.more.map((item) => (
          <div>
            <dt class="font-medium text-zinc-100">{item.title}</dt>
            <dd class="mt-1 text-sm text-zinc-400 leading-relaxed">{item.description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
