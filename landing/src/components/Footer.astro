---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.footer;

const githubRepo = 'https://github.com/thucne/EiSen';
const homePath = locale === 'vi' ? '/vi/' : '/';
---

<footer class="border-t border-white/10 py-10 sm:py-14 text-zinc-400 text-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8 sm:mb-12">
      <div class="col-span-2 space-y-3">
        <img src="/brand/eisen-horizontal-reversed.svg" alt="EiSen" class="h-8 w-auto object-contain" width="130" height="48" />
        <p class="text-zinc-300 max-w-md">{f.tagline}</p>
        <p class="text-zinc-400 max-w-md leading-relaxed">{f.privacyCommitment}</p>
      </div>

      <div>
        <h4 class="font-medium text-zinc-100 mb-3">{f.productTitle}</h4>
        <ul class="space-y-2">
          <li><a href={`${homePath}#features`} class="hover:text-white transition-colors">{t.nav.features}</a></li>
          <li><a href={`${homePath}#setup`} class="hover:text-white transition-colors">{t.nav.shortcuts}</a></li>
          <li><a href={`${homePath}#comparison`} class="hover:text-white transition-colors">{t.nav.comparison}</a></li>
          <li><a href={locale === 'vi' ? '/vi/changelog' : '/changelog'} class="hover:text-white transition-colors">{t.nav.changelog}</a></li>
          <li><a href={locale === 'vi' ? '/vi/windows' : '/windows'} class="hover:text-white transition-colors">{f.windowsLink}</a></li>
          <li><a href="/cleanshot-alternative" class="hover:text-white transition-colors">{f.alternativeLink}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-medium text-zinc-100 mb-3">{f.linksTitle}</h4>
        <ul class="space-y-2">
          <li><a href={githubRepo} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{f.sourceCode}</a></li>
          <li><a href={`${githubRepo}/releases`} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{f.releases}</a></li>
          <li><a href={`${githubRepo}/blob/main/PRIVACY.md`} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{f.privacyDoc}</a></li>
          <li><a href={`${githubRepo}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{f.mitLicense}</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        © {new Date().getFullYear()} EiSen. {f.licensePrefix} <a href={`${githubRepo}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-zinc-600 hover:text-white">{f.mitLicense}</a>.
      </div>
      <div>
        {f.author} <a href="https://github.com/thucne" target="_blank" rel="noopener noreferrer" class="text-zinc-200 hover:text-white">@thucne</a>
      </div>
    </div>
  </div>
</footer>
