---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const { locale, title, description, canonicalUrl } = Astro.props;
const t = getDictionary(locale);

const siteUrl = 'https://eisen.a302.link';
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const currentUrl = canonicalUrl ?? (locale === 'vi' ? `${siteUrl}/vi/` : `${siteUrl}/`);
const enUrl = `${siteUrl}/`;
const viUrl = `${siteUrl}/vi/`;
const ogImageUrl = `${siteUrl}/brand/eisen-mark-reversed-1024.png`;
const dmgUrl = 'https://github.com/thucne/EiSen/releases/download/v0.1.2/EiSen_0.1.2_aarch64.dmg';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'EiSen',
  alternateName: ['EiSen Mac Screenshot', 'EiSen Screen Capture', 'EiSen Free Screenshot App'],
  operatingSystem: 'macOS 11.0+',
  applicationCategory: 'UtilitiesApplication',
  applicationSubCategory: 'Screen Capture & Annotation',
  inLanguage: locale === 'vi' ? 'vi' : 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    description: '100% Free and Open-Source macOS screenshot & annotation utility',
  },
  description: t.meta.description,
  softwareVersion: '0.1.2',
  fileSize: '4.2MB',
  url: siteUrl,
  downloadUrl: dmgUrl,
  sameAs: ['https://github.com/thucne/EiSen'],
  author: {
    '@type': 'Person',
    name: 'Tran Trong Thuc',
    url: 'https://github.com/thucne',
  },
  screenshot: `${siteUrl}/brand/eisen-mark-1024.png`,
  featureList: [
    '100% Free Mac Screenshot Tool',
    'Free Alternative to CleanShot X & Shottr',
    'Native Rust capture overlay',
    'On-device Apple Vision OCR',
    'Zero telemetry — capture, save, and OCR stay on this Mac',
    'Menu bar accessory (no Dock icon)',
    'Numbered-step annotation',
    'Privacy blur baked into exported PNGs',
    'Eyedropper pixel loupe',
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<!-- Basic Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="keywords" content={t.meta.keywords} />
<meta name="author" content="Tran Trong Thuc" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Canonical and Alternate Languages (hreflang) -->
<link rel="canonical" href={currentUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="vi" href={viUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content="EiSen — Screen Capture & Annotation for macOS" />
<meta property="og:site_name" content="EiSen" />
<meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'vi' ? 'en_US' : 'vi_VN'} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
