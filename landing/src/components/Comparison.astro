---
import type { Locale } from '../i18n/utils';
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const c = t.comparison;

const cellClass = 'block sm:table-cell py-1 sm:py-4 sm:px-4 text-sm text-zinc-400 align-top before:content-[attr(data-label)] before:block before:text-xs before:text-zinc-500 sm:before:content-none';
---

<section id="comparison" class="py-16 sm:py-24 border-t border-white/10 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-50">{c.title}</h2>
      <p class="mt-4 text-lg text-zinc-400 leading-relaxed">{c.subtitle}</p>
    </div>

    <!-- A table from sm up; on phones each row becomes a labeled two-column grid -->
    <table class="mt-10 sm:mt-14 w-full text-left sm:table-fixed block sm:table">
      <thead class="hidden sm:table-header-group">
        <tr class="border-b border-white/15">
          <th scope="col" class="py-3 pr-4 text-sm font-medium text-zinc-400 w-[22%]">{c.feature}</th>
          <th scope="col" class="py-3 px-4 text-sm font-semibold text-zinc-50 w-[16%]">{c.eisen}</th>
          <th scope="col" class="py-3 px-4 text-sm font-medium text-zinc-400 w-[14%]">{c.macosDefault}</th>
          <th scope="col" class="py-3 px-4 text-sm font-medium text-zinc-400 w-[24%]">{c.cleanshot}</th>
          <th scope="col" class="py-3 px-4 text-sm font-medium text-zinc-400 w-[24%]">{c.shottr}</th>
        </tr>
      </thead>
      <tbody class="block sm:table-row-group divide-y divide-white/10">
        {c.rows.map((row) => (
          <tr class="grid grid-cols-2 gap-x-4 sm:table-row py-4 sm:py-0">
            <th scope="row" class="col-span-2 sm:table-cell pb-2 sm:py-4 sm:pr-4 text-sm font-medium text-zinc-200 align-top">{row.name}</th>
            <td data-label={c.eisen} class:list={[cellClass, '!text-zinc-50 font-medium sm:bg-white/[0.04]']}>{row.eisen}</td>
            <td data-label={c.macosDefault} class={cellClass}>{row.macos}</td>
            <td data-label={c.cleanshot} class={cellClass}>{row.cleanshot}</td>
            <td data-label={c.shottr} class={cellClass}>{row.shottr}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="mt-8 text-sm text-zinc-400 leading-relaxed">
      {c.sourcesLabel}
      <a href="https://cleanshot.com/pricing" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-zinc-600 hover:text-white">CleanShot X</a>,
      <a href="https://shottr.cc/purchase.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-zinc-600 hover:text-white">Shottr</a>.
    </p>
    <a href="/cleanshot-alternative" class="mt-3 inline-block text-sm text-zinc-300 underline underline-offset-4 decoration-zinc-600 hover:text-white">
      {c.detailLink} →
    </a>
  </div>
</section>
