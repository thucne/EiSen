    <!-- Client Script: Automated 4-Scene Loop + Recording Controls -->
    <script is:inline>
      // Aggressive suppression of Astro Dev Toolbar
      const cleanAstroToolbar = () => {
        document.querySelectorAll("astro-dev-toolbar, #astro-dev-toolbar, [data-astro-dev-toolbar]").forEach((el) => {
          el.remove();
        });
      };
      cleanAstroToolbar();
      setInterval(cleanAstroToolbar, 100);

      const scenes = [
        { id: "scene-1", bar: "bar-1", duration: 3500 },
        { id: "scene-2", bar: "bar-2", duration: 3700 },
        { id: "scene-3", bar: "bar-3", duration: 3700 },
        { id: "scene-4", bar: "bar-4", duration: 4100 },
      ];

      let currentIndex = 0;
      let timer = null;
      let keyTimer1 = null;
      let keyTimer2 = null;

      // Check clean/export mode for headless automation
      const urlParams = new URLSearchParams(window.location.search);
      const isClean = urlParams.get("clean") === "1" || urlParams.get("export") === "1";
      if (isClean) {
        const btn = document.getElementById("btn-record");
        if (btn) btn.style.display = "none";
      }

      function animateKeys() {
        const k1 = document.getElementById("key-opt-1");
        const k2 = document.getElementById("key-opt-2");
        if (!k1 || !k2) return;

        clearTimeout(keyTimer1);
        clearTimeout(keyTimer2);

        // Reset
        k1.classList.remove("bg-indigo-500", "scale-95", "ring-4", "ring-indigo-400/50");
        k2.classList.remove("bg-indigo-500", "scale-95", "ring-4", "ring-indigo-400/50");

        // Tap 1
        keyTimer1 = setTimeout(() => {
          k1.classList.add("bg-indigo-500", "scale-95", "ring-4", "ring-indigo-400/50");
          setTimeout(() => {
            k1.classList.remove("bg-indigo-500", "scale-95", "ring-4", "ring-indigo-400/50");
          }, 200);
        }, 500);

        // Tap 2
        keyTimer2 = setTimeout(() => {
          k2.classList.add("bg-indigo-500", "scale-95", "ring-4", "ring-indigo-400/50");
          setTimeout(() => {
            k2.classList.remove("bg-indigo-500", "scale-95", "ring-4", "ring-indigo-400/50");
          }, 200);
        }, 800);
      }

      function switchScene(index) {
        currentIndex = (index + scenes.length) % scenes.length;
        clearTimeout(timer);

        scenes.forEach((s, i) => {
          const el = document.getElementById(s.id);
          const bar = document.getElementById(s.bar);
          if (!el || !bar) return;

          if (i < currentIndex) {
            // Completed scenes
            bar.style.transition = "none";
            bar.style.width = "100%";
            el.classList.add("opacity-0", "translate-y-4");
            el.classList.remove("opacity-100", "translate-y-0");
            setTimeout(() => { if (currentIndex !== i) el.classList.add("hidden"); }, 300);
          } else if (i === currentIndex) {
            // Active scene
            el.classList.remove("hidden");
            requestAnimationFrame(() => {
              el.classList.remove("opacity-0", "translate-y-4");
              el.classList.add("opacity-100", "translate-y-0");
            });

            // Smooth linear fill over duration
            bar.style.transition = "none";
            bar.style.width = "0%";
            void bar.offsetWidth; // force reflow
            bar.style.transition = "width " + s.duration + "ms linear";
            bar.style.width = "100%";

            if (i === 0) {
              animateKeys();
            }
          } else {
            // Future scenes
            bar.style.transition = "none";
            bar.style.width = "0%";
            el.classList.add("opacity-0", "translate-y-4");
            el.classList.remove("opacity-100", "translate-y-0");
            setTimeout(() => { if (currentIndex !== i) el.classList.add("hidden"); }, 300);
          }
        });

        timer = setTimeout(() => {
          switchScene(currentIndex + 1);
        }, scenes[currentIndex].duration);
      }

      // Tap navigation
      const tapPrev = document.getElementById("tap-prev");
      const tapNext = document.getElementById("tap-next");
      if (tapPrev) tapPrev.addEventListener("click", () => switchScene(currentIndex - 1));
      if (tapNext) tapNext.addEventListener("click", () => switchScene(currentIndex + 1));

      // Start automatic story playback
      switchScene(0);

      // Expose to window for automation/playwright
      window.EiSenStory = {
        switchScene,
        scenes,
        getCurrentIndex: () => currentIndex,
        getTotalDuration: () => scenes.reduce((acc, s) => acc + s.duration, 0),
      };

      // In-browser MediaRecorder recording button
      const btnRecord = document.getElementById("btn-record");
      const recordText = document.getElementById("record-text");
      let mediaRecorder = null;
      let recordedChunks = [];

      if (btnRecord) {
        btnRecord.addEventListener("click", async () => {
          if (mediaRecorder && mediaRecorder.state === "recording") {
            mediaRecorder.stop();
            return;
          }

          try {
            recordText.textContent = "Recording...";
            btnRecord.classList.add("bg-red-500/30", "border-red-500");

            switchScene(0);

            const stream = await navigator.mediaDevices.getDisplayMedia({
              video: { displaySurface: "browser" },
              audio: false,
            });

            mediaRecorder = new MediaRecorder(stream, { mimeType: "video/webm;codecs=vp9" });
            recordedChunks = [];

            mediaRecorder.ondataavailable = (e) => {
              if (e.data.size > 0) recordedChunks.push(e.data);
            };

            mediaRecorder.onstop = () => {
              const blob = new Blob(recordedChunks, { type: "video/webm" });
              const url = URL.createObjectURL(blob);
              const a = document.createElement("a");
              a.href = url;
              a.download = "eisen-story-promo.webm";
              a.click();
              URL.revokeObjectURL(url);
              stream.getTracks().forEach((t) => t.stop());
              recordText.textContent = "Auto Clip";
              btnRecord.classList.remove("bg-red-500/30", "border-red-500");
            };

            mediaRecorder.start();

            setTimeout(() => {
              if (mediaRecorder && mediaRecorder.state === "recording") {
                mediaRecorder.stop();
              }
            }, 15000);
          } catch (err) {
            console.error(err);
            recordText.textContent = "Auto Clip";
            btnRecord.classList.remove("bg-red-500/30", "border-red-500");
          }
        });
      }
    </script>
  </body>
</html>
