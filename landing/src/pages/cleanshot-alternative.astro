---
import Layout from '../layouts/Layout.astro';
import AppleIcon from '../components/AppleIcon.astro';
import WindowsIcon from '../components/WindowsIcon.astro';
import GithubIcon from '../components/GithubIcon.astro';
import { dmgDownloadPath, exeDownloadPath, getDictionary, githubUrl, microsoftStoreUrl } from '../i18n/utils';

const dmgUrl = dmgDownloadPath;
const exeUrl = exeDownloadPath;
const downloadCopy = getDictionary('en').downloadSection;

const title = 'Free CleanShot X Alternative for Mac & Windows | EiSen';
const description = 'Looking for a free, open-source CleanShot X alternative for Mac or Windows? EiSen gives you screen capture, step markers, blur, and on-device OCR with no subscription.';
const canonicalUrl = 'https://eisen.a302.link/cleanshot-alternative';

const comparisonRows = [
  { feature: 'Price', eisen: 'Free (MIT open source)', cleanshot: '$35 once with 1 year of updates ($19/year to renew), or Pro from $10/month' },
  { feature: 'Cloud', eisen: 'None: no upload feature', cleanshot: 'Optional CleanShot Cloud, not required to use the app' },
  { feature: 'Text OCR', eisen: 'On device (Apple Vision on macOS; Windows.Media.Ocr on Windows)', cleanshot: 'On device' },
  { feature: 'Cover sensitive content', eisen: 'Solid Redact and Blur', cleanshot: 'Pixelate and Blur' },
  { feature: 'Screen recording', eisen: 'No', cleanshot: 'Yes, with a video editor' },
  { feature: 'Scrolling capture', eisen: 'No', cleanshot: 'Yes' },
  { feature: 'Download Package Size', eisen: '4.61 MB macOS DMG / 2.73 MB Windows NSIS fallback; Store package varies', cleanshot: 'Varies by release' },
  { feature: 'Account or license', eisen: 'None', cleanshot: 'License key' },
  { feature: 'Platform Support', eisen: 'macOS 11+ (Apple Silicon download) & Windows 10/11 (64-bit)', cleanshot: 'macOS 13+' },
];

const faqs = [
  {
    q: 'Why look for a CleanShot X alternative at all?',
    a: "CleanShot X is a strong tool with recording and cloud sharing that EiSen doesn't have. EiSen suits people who only need capture, annotation, redaction, and OCR, want to pay nothing, or prefer a tool with no upload feature at all."
  },
  {
    q: 'Can EiSen extract text from images like CleanShot X OCR?',
    a: 'Yes. EiSen includes on-device OCR: Apple Vision on macOS and Windows.Media.Ocr on Windows. Select a region and copy the recognized text to your clipboard, with no connection needed.'
  },
  {
    q: 'Is EiSen truly free and open-source?',
    a: 'Yes. EiSen is MIT licensed with its full source code on GitHub. There is no paid tier and no upgrade prompt.'
  },
  {
    q: 'How does EiSen compare to Shottr?',
    a: 'Shottr is a small native Mac app, free to use with reminders after 30 days, $12 for a license, and it has scrolling capture and S3 upload. EiSen is open source with no paid tier, has no upload feature, and also runs on Windows.'
  },
];
---

<Layout
  locale="en"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <div class="relative pt-12 pb-20 sm:pt-16 sm:pb-28 overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb & Tag -->
      <div class="text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs sm:text-sm font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>100% Free & Open Source Alternative</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
          The free, private CleanShot X alternative for Mac &amp; Windows
        </h1>

        <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
          If you don't need recording or cloud sharing, you may not need to pay. EiSen gives you screen capture, numbered steps, blur, a pixel loupe, and on-device OCR on macOS and Windows, free and open source.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <a
            href={dmgUrl}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 sm:px-8 py-3.5 rounded-2xl bg-gradient-to-r from-indigo-500 via-indigo-600 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold text-sm sm:text-base shadow-xl shadow-indigo-500/25 transition-all duration-200 group"
          >
            <AppleIcon class="w-5 h-5 shrink-0" size={20} />
            <span>Download EiSen Free for Mac</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-white/20 font-mono font-medium">DMG (4.61 MB)</span>
          </a>

          <a
            href={microsoftStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 sm:px-8 py-3.5 rounded-2xl bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-sm sm:text-base shadow-xl shadow-cyan-600/25 transition-all duration-200 group"
          >
            <WindowsIcon class="w-5 h-5 shrink-0" size={20} />
            <span>Get from Microsoft Store</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-white/20 font-mono font-medium">MSIX</span>
          </a>

          <a
            href={exeUrl}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-amber-400/25 text-amber-100 hover:text-white font-medium text-sm sm:text-base transition-all duration-200 group"
          >
            <WindowsIcon class="w-4 h-4 shrink-0 text-amber-300" size={18} />
            <span>Direct .exe fallback</span>
          </a>

          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 text-slate-200 hover:text-white font-medium text-sm sm:text-base backdrop-blur-md transition-all duration-200"
          >
            <GithubIcon class="w-5 h-5" size={20} />
            <span>View Source on GitHub</span>
          </a>
        </div>

        <div role="note" class="max-w-2xl mx-auto rounded-xl border border-amber-400/30 bg-amber-400/10 p-3 text-left text-xs text-amber-100">
          <p class="font-semibold text-amber-200">{downloadCopy.windowsWarningTitle}</p>
          <p class="mt-1 leading-relaxed">{downloadCopy.windowsWarning}</p>
        </div>

        <p class="text-xs text-slate-400 pt-1">
          macOS 11+ (Apple Silicon download) and Windows 10/11 (64-bit) • Zero telemetry
        </p>
      </div>

      <!-- Feature Comparison Table -->
      <div class="mt-16 sm:mt-20">
        <div class="text-center mb-8">
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white">EiSen vs. CleanShot X</h2>
          <p class="text-sm sm:text-base text-slate-300 mt-2">Side-by-side feature and architectural comparison.</p>
        </div>

        <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#161822]/90 shadow-2xl backdrop-blur-xl">
          <table class="min-w-full divide-y divide-white/10 text-left">
            <thead>
              <tr class="bg-white/[0.03]">
                <th scope="col" class="py-4 px-4 sm:px-6 text-xs sm:text-sm font-semibold text-slate-300">Feature</th>
                <th scope="col" class="py-4 px-4 sm:px-6 text-sm sm:text-base font-bold text-indigo-400 bg-indigo-500/10 border-x border-indigo-500/20">
                  <div class="flex items-center gap-2">
                    <span>EiSen</span>
                    <span class="text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">Free / Open Source</span>
                  </div>
                </th>
                <th scope="col" class="py-4 px-4 sm:px-6 text-xs sm:text-sm font-medium text-slate-400">CleanShot X</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-xs sm:text-sm">
              {comparisonRows.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-transparent' : 'bg-white/[0.01]'}>
                  <td class="py-3.5 px-4 sm:px-6 font-medium text-slate-200">{row.feature}</td>
                  <td class="py-3.5 px-4 sm:px-6 font-semibold text-emerald-400 bg-indigo-500/5 border-x border-indigo-500/20">
                    {row.eisen}
                  </td>
                  <td class="py-3.5 px-4 sm:px-6 text-slate-400">{row.cleanshot}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Why Choose EiSen Grid -->
      <div class="mt-20 space-y-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white text-center">
          Why choose EiSen
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/10 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
              $0
            </div>
            <h3 class="text-lg font-bold text-white">Free, with no paid tier</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              No subscription, no renewal fee, and no locked features. Everything in EiSen is free for personal and commercial use under the MIT license.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/10 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold">
              🔒
            </div>
            <h3 class="text-lg font-bold text-white">Stays on your device</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              EiSen makes no network requests for capture, save, OCR, or settings. OCR uses Apple Vision on macOS or Windows.Media.Ocr on Windows, on your own computer.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/10 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold">
              ⚡
            </div>
            <h3 class="text-lg font-bold text-white">Lightweight Native App</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Built with Rust and Tauri v2. It runs quietly from the macOS menu bar or Windows system tray.
            </p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mt-20">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white text-center mb-8">
          Frequently Asked Questions
        </h2>

        <div class="space-y-4 max-w-3xl mx-auto">
          {faqs.map((faq) => (
            <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2">
              <h3 class="text-base sm:text-lg font-semibold text-white">{faq.q}</h3>
              <p class="text-sm text-slate-300 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Download Callout -->
      <div class="mt-20 text-center p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-indigo-950/40 to-[#12141d] border border-indigo-500/20 space-y-5">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white">
          Ready to try the free CleanShot alternative?
        </h2>
        <p class="text-base text-slate-300 max-w-xl mx-auto">
          Download EiSen and try it on your next screenshot, on macOS or Windows.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={dmgUrl}
            class="inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-base shadow-xl shadow-indigo-600/30 transition-all duration-200"
          >
            <AppleIcon class="w-5 h-5" size={20} />
            <span>Download EiSen Free (.dmg)</span>
          </a>
          <a
            href={microsoftStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-2xl bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-base shadow-xl shadow-cyan-600/30 transition-all duration-200"
          >
            <WindowsIcon class="w-5 h-5" size={20} />
            <span>Get from Microsoft Store</span>
          </a>
          <a
            href={exeUrl}
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-amber-400/25 text-amber-100 hover:text-white font-medium text-base transition-all duration-200"
          >
            <WindowsIcon class="w-4 h-4 text-amber-300" size={18} />
            <span>Direct .exe fallback</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
