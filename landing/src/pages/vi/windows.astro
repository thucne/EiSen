---
import Layout from '../../layouts/Layout.astro';
import WindowsIcon from '../../components/WindowsIcon.astro';
import AppleIcon from '../../components/AppleIcon.astro';
import GithubIcon from '../../components/GithubIcon.astro';
import { exeDownloadPath, githubUrl } from '../../i18n/utils';
import { vi } from '../../i18n/vi';

const t = vi.windowsPage;
const title = t.meta.title;
const description = t.meta.description;
const canonicalUrl = 'https://eisen.a302.link/vi/windows';

const comparisonRows = [
  {
    feature: 'Chi phí & Bản quyền',
    eisen: '100% Miễn phí trọn đời (MIT Open Source)',
    snipping: 'Miễn phí (Tích hợp sẵn)',
    sharex: 'Miễn phí (Donation / Phức tạp)',
  },
  {
    feature: 'Dung lượng trên ổ đĩa',
    eisen: '~4.5 MB sau khi cài (Viết bằng Native Rust)',
    snipping: 'Tích hợp hệ thống',
    sharex: '80 MB – 140 MB (Cần .NET runtime)',
  },
  {
    feature: 'Độ trễ khi mở chụp',
    eisen: '< 5 ms (Đóng băng và mở tức thì)',
    snipping: '250 ms – 600 ms',
    sharex: '100 ms – 300 ms',
  },
  {
    feature: 'Bảo mật & Quyền riêng tư',
    eisen: '100% Ngoại tuyến (Không cloud, không theo dõi)',
    snipping: 'Có gửi dữ liệu chẩn đoán của Windows',
    sharex: 'Dễ vô tình upload ảnh lên web công khai',
  },
  {
    feature: 'Nhận diện chữ OCR trên máy',
    eisen: 'Windows.Media.Ocr native (WinRT offline)',
    snipping: 'Cơ bản (Chỉ có trên Windows 11)',
    sharex: 'Cần cấu hình Tesseract / API bên ngoài',
  },
  {
    feature: 'Chạy trên khay hệ thống (System Tray)',
    eisen: 'Nhẹ nhàng, êm ái, tốn cực ít RAM',
    snipping: 'Dạng cửa sổ ứng dụng riêng',
    sharex: 'Có, nhưng menu hơn 100 mục rối mắt',
  },
  {
    feature: 'Trải nghiệm công cụ chú thích',
    eisen: 'Bộ công cụ kính mờ hiện đại & bước số tự tăng',
    snipping: 'Chỉ có vẽ bút dạ và cắt cơ bản',
    sharex: 'Giao diện chỉnh sửa phức tạp, khó dùng',
  },
  {
    feature: 'Quyền hạn khi cài đặt',
    eisen: 'Bộ cài Per-User (Không cần quyền Admin)',
    snipping: 'Hệ thống',
    sharex: 'Tùy thuộc phiên bản',
  },
];

const faqs = [
  {
    q: 'EiSen hỗ trợ các phiên bản Windows nào?',
    a: 'EiSen hỗ trợ Windows 10 64-bit (phiên bản 1809 trở lên) và tất cả các phiên bản của Windows 11. Ứng dụng tận dụng trực tiếp API WinRT hiện đại và Rust để tối ưu hóa hiệu suất.',
  },
  {
    q: 'Có cần quyền Administrator để cài đặt EiSen trên Windows không?',
    a: 'Không cần! Bộ cài EiSen được cấu hình cài đặt độc lập vào thư mục người dùng của bạn (chế độ currentUser). Bạn có thể dễ dàng cài đặt trên máy tính công ty hoặc máy bị giới hạn quyền Admin.',
  },
  {
    q: 'Tính năng nhận diện chữ OCR hoạt động thế nào khi không có Internet?',
    a: 'EiSen tích hợp trực tiếp với framework Windows.Media.Ocr có sẵn trong hệ điều hành Windows. Quá trình nhận diện chữ diễn ra 100% tại máy tính của bạn, hỗ trợ các ngôn ngữ đã cài trong máy và hoàn toàn bảo mật.',
  },
  {
    q: 'Tôi có thể dùng phím PrintScreen (PrtScn) để chụp với EiSen không?',
    a: 'Hoàn toàn được! EiSen gán trực tiếp phím PrintScreen (PrtScn) trên Windows. Phần Cài đặt Windows hiển thị phím tắt được hỗ trợ này.',
  },
  {
    q: 'EiSen có thực sự miễn phí 100% không hay có điều kiện gì?',
    a: 'EiSen hoàn toàn miễn phí trọn đời và là dự án mã nguồn mở theo giấy phép MIT. Không có gói tháng, không quảng cáo, không theo dõi và không có tính năng khóa sau tường phí (paywall).',
  },
];
---

<Layout
  locale="vi"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 sm:pt-16 sm:pb-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb badge -->
      <div class="text-center space-y-4 max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs sm:text-sm font-medium animate-fade-in shadow-inner shadow-cyan-500/10">
          <WindowsIcon class="w-3.5 h-3.5" size={14} />
          <span>{t.badge}</span>
        </div>

        <h1 class="text-3xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.15] sm:leading-[1.1]">
          {t.titleStart}{' '}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400">
            {t.titleHighlight}
          </span>{' '}
          {t.titleEnd}
        </h1>

        <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
          {t.subtitle}
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href={exeDownloadPath}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white font-bold text-base shadow-xl shadow-cyan-500/30 hover:shadow-cyan-500/50 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
          >
            <WindowsIcon class="w-5 h-5 shrink-0" size={20} />
            <span>{t.downloadCta}</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-white/20 font-mono font-medium">EXE (~2.6MB)</span>
          </a>

          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 text-slate-200 hover:text-white font-medium text-base transition-all duration-200"
          >
            <GithubIcon class="w-5 h-5 shrink-0" size={20} />
            <span>Mã nguồn trên GitHub</span>
          </a>
        </div>

        <p class="text-xs text-slate-400 font-medium pt-1">
          Hỗ trợ Windows 10 & 11 (64-bit) • Bộ cài Per-User • Không telemetry
        </p>

        <div role="note" class="mx-auto mt-4 max-w-2xl rounded-xl border border-amber-400/30 bg-amber-400/10 p-4 text-left text-sm text-amber-100">
          <p class="font-semibold text-amber-200">{t.installWarningTitle}</p>
          <p class="mt-1 leading-relaxed">{t.installWarning}</p>
        </div>
      </div>

      <!-- Windows 11 App Showcase Mockup -->
      <div class="mt-12 sm:mt-16 max-w-5xl mx-auto">
        <div class="relative rounded-2xl p-2 sm:p-4 bg-gradient-to-b from-white/15 to-white/5 border border-white/10 shadow-2xl shadow-black/80 backdrop-blur-2xl">
          <!-- Windows 11 Titlebar -->
          <div class="flex items-center justify-between pb-2.5 sm:pb-3 px-2 sm:px-3 border-b border-white/5 text-xs text-slate-400 font-sans">
            <div class="flex items-center gap-2 min-w-0">
              <WindowsIcon class="w-3.5 h-3.5 text-cyan-400 shrink-0" size={14} />
              <span class="text-slate-300 font-medium truncate">EiSen Screen Capture Overlay — Phiên Bản Windows 11</span>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="hidden sm:inline-flex items-center gap-1 text-[11px] bg-white/10 px-2 py-0.5 rounded text-slate-300 font-mono">
                <kbd>PrtScn</kbd> Trigger
              </span>
              <div class="flex items-center gap-2.5 font-mono text-slate-400 text-xs pl-2 border-l border-white/10">
                <span class="hover:text-white cursor-default">─</span>
                <span class="hover:text-white cursor-default">□</span>
                <span class="hover:text-red-400 cursor-default">✕</span>
              </div>
            </div>
          </div>

          <!-- Simulated Capture Workspace -->
          <div class="relative mt-3 rounded-xl overflow-hidden bg-[#161822] border border-white/10 min-h-[360px] sm:min-h-[440px] flex items-center justify-center p-2 sm:p-4">
            <!-- Background Code Illusion -->
            <div class="absolute inset-0 opacity-20 font-mono text-[10px] sm:text-[11px] text-cyan-300 p-4 sm:p-6 select-none overflow-hidden leading-relaxed pointer-events-none">
              <p>// EiSen Core - Native Rust Windows Capture Engine</p>
              <p>use windows::Media::Ocr::OcrEngine;</p>
              <p>pub async fn extract_text_from_image(bytes: &amp;[u8]) -&gt; Result&lt;String&gt; &#123;</p>
              <p>&nbsp;&nbsp;let engine = OcrEngine::TryCreateFromUserProfileLanguages()?;</p>
              <p>&nbsp;&nbsp;let software_bitmap = decode_stream_to_bitmap(bytes)?;</p>
              <p>&nbsp;&nbsp;let ocr_result = engine.RecognizeAsync(&amp;software_bitmap)?.await?;</p>
              <p>&nbsp;&nbsp;Ok(ocr_result.Text()?.to_string())</p>
              <p>&#125;</p>
            </div>

            <!-- Crop Area -->
            <div class="relative w-full max-w-2xl rounded-xl border-2 border-cyan-500 bg-cyan-500/5 shadow-[0_0_50px_-10px_rgba(6,182,212,0.4)] p-3.5 sm:p-6 z-10 flex flex-col justify-between min-h-[260px] sm:min-h-[300px]">
              <div class="absolute -top-3 left-3 sm:-top-3.5 sm:left-4 px-2 sm:px-2.5 py-0.5 rounded-md bg-cyan-600 text-white font-mono text-[10px] sm:text-[11px] font-semibold shadow-md flex items-center gap-1.5">
                <span>920 × 520</span>
                <span class="text-cyan-200">|</span>
                <span>125% DPI</span>
              </div>

              <div class="space-y-3">
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 text-white text-xs font-bold flex items-center justify-center shadow-lg shadow-cyan-500/40 shrink-0">1</span>
                  <span class="text-xs sm:text-sm font-semibold text-white bg-slate-900/80 px-3 py-1 rounded-lg border border-white/10 backdrop-blur-md">
                    Cắt ảnh tức thì trên bất kỳ màn hình Windows nào
                  </span>
                </div>

                <div class="inline-flex items-center gap-2 p-2 sm:p-2.5 rounded-lg bg-slate-950/80 border border-red-500/30 backdrop-blur-md">
                  <span class="text-xs text-red-400 font-medium">🔒 Che mờ:</span>
                  <span class="font-mono text-xs text-slate-400 blur-sm select-none">ghp_928374829102938472910</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-red-500/20 text-red-300 font-semibold uppercase">Blur</span>
                </div>

                <div class="inline-flex items-center gap-2.5 p-2.5 rounded-xl bg-[#1e2235]/95 border border-cyan-500/40 shadow-xl backdrop-blur-md">
                  <div class="w-6 h-6 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-xs shrink-0">
                    T
                  </div>
                  <div>
                    <div class="text-[11px] text-cyan-300 font-semibold flex items-center gap-1.5">
                      <span>Windows Media OCR</span>
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span class="text-[10px] text-emerald-400 font-mono">Đã sao chép vào Clipboard!</span>
                    </div>
                    <p class="text-xs text-slate-200 font-mono truncate">&quot;use windows::Media::Ocr::OcrEngine;&quot;</p>
                  </div>
                </div>
              </div>

              <!-- Loupe -->
              <div class="self-end flex items-center gap-2 bg-black/85 border border-white/20 px-2.5 py-1 rounded-xl shadow-2xl backdrop-blur-lg">
                <div class="w-4 h-4 rounded-full bg-[#06b6d4] border border-white/50 shadow-sm shrink-0"></div>
                <div class="font-mono text-xs">
                  <span class="text-cyan-400 font-bold">#06B6D4</span>
                  <span class="text-slate-400 text-[10px] ml-1">RGB(6, 182, 212)</span>
                </div>
              </div>

              <!-- Action Toolbar -->
              <div class="absolute -bottom-5 sm:-bottom-6 left-1/2 -translate-x-1/2 w-auto bg-[#12141d]/95 border border-white/20 rounded-xl px-3 py-1.5 shadow-2xl backdrop-blur-xl flex items-center gap-2">
                <span class="font-bold text-xs px-2 py-1 rounded bg-white/10 text-white">Chọn</span>
                <span class="text-xs px-2 py-1 rounded text-slate-300 hover:text-white">Chữ</span>
                <span class="text-xs px-2 py-1 rounded text-slate-300 hover:text-white">Mũi tên</span>
                <span class="text-xs px-2 py-1 rounded text-cyan-400 bg-cyan-500/15 font-bold">① Bước</span>
                <span class="text-xs px-2 py-1 rounded text-slate-300 hover:text-white">Làm mờ</span>
                <span class="text-xs px-2.5 py-1 rounded bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold">OCR</span>
                <span class="text-xs px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-300 font-semibold border border-emerald-500/30">Chép</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Cards Grid -->
  <section class="py-16 sm:py-20 bg-white/[0.02] border-y border-white/5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-4">
          {t.whyTitle}
        </h2>
        <p class="text-slate-300 text-base sm:text-lg">
          {t.whySubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {t.cards.map((card) => (
          <div class="p-6 rounded-2xl bg-[#161822]/70 border border-white/10 hover:border-cyan-500/40 hover:bg-[#161822]/90 transition-all duration-200">
            <div class="text-3xl mb-4">{card.icon}</div>
            <h3 class="text-lg font-bold text-white mb-2">{card.title}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison Section -->
  <section class="py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-4">
          {t.comparisonTitle}
        </h2>
        <p class="text-slate-300 text-base sm:text-lg">
          {t.comparisonSubtitle}
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10 bg-[#161822]/80 backdrop-blur-xl">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-white/10 bg-white/5 text-slate-200 font-semibold">
              <th class="py-4 px-5">Tính năng</th>
              <th class="py-4 px-5 text-cyan-400">EiSen (Windows)</th>
              <th class="py-4 px-5 text-slate-400">Snipping Tool</th>
              <th class="py-4 px-5 text-slate-400">ShareX</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {comparisonRows.map((row) => (
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-5 font-medium text-slate-200">{row.feature}</td>
                <td class="py-3.5 px-5 font-semibold text-cyan-300 bg-cyan-500/5">{row.eisen}</td>
                <td class="py-3.5 px-5 text-slate-400">{row.snipping}</td>
                <td class="py-3.5 px-5 text-slate-400">{row.sharex}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 sm:py-20 bg-white/[0.02] border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-4">
          Hỏi Đáp Về Bản Windows
        </h2>
        <p class="text-slate-300">Giải đáp các câu hỏi phổ biến khi sử dụng EiSen trên Windows 10 và 11.</p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-[#161822]/70 border border-white/10">
            <h3 class="text-base sm:text-lg font-bold text-white mb-2">{faq.q}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-cyan-500/10 via-[#161822] to-[#12141d] border border-cyan-500/30 shadow-2xl backdrop-blur-xl">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          Trải Nghiệm Chụp Ảnh Màn Hình Siêu Tốc Trên Windows
        </h2>
        <p class="text-slate-300 max-w-xl mx-auto mb-8 text-base sm:text-lg">
          Gọn nhẹ sau khi cài, độ trễ chụp dưới 5ms, nhận diện chữ Windows.Media.Ocr và bảo mật 100% offline.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={exeDownloadPath}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-base shadow-xl shadow-cyan-500/30 hover:-translate-y-0.5 transition-all"
          >
            <WindowsIcon class="w-5 h-5 shrink-0" size={20} />
            <span>Tải Cho Windows (.exe)</span>
          </a>

          <a
            href="/vi/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 text-slate-200 hover:text-white font-medium text-base transition-all"
          >
            <AppleIcon class="w-4 h-4 shrink-0" size={16} />
            <span>Tìm bản cho macOS?</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
