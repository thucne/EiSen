---
import SeoHead from '../components/SeoHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const { locale, title, description, canonicalUrl } = Astro.props;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0f1015" />
    <SeoHead locale={locale} title={title} description={description} canonicalUrl={canonicalUrl} />
    <!-- Set before first paint so phones never flash a DMG button they can't use. -->
    <script is:inline>
      (() => {
        const ua = navigator.userAgent;
        const isPhone = /iphone|ipad|ipod|android/i.test(ua) || (/macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
        if (isPhone) document.documentElement.dataset.device = 'phone';
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#0f1015] text-zinc-100 selection:bg-[#ff6b3d] selection:text-zinc-950 relative" data-share-url={locale === 'vi' ? 'https://eisen.a302.link/vi/' : 'https://eisen.a302.link/'}>
    <div class="flex flex-col min-h-screen">
      <Navbar locale={locale} />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>

    <script is:inline>
      document.addEventListener('click', async (event) => {
        const button = event.target instanceof Element ? event.target.closest('[data-copy-link]') : null;
        if (!button) return;
        const url = document.body.dataset.shareUrl;
        const label = button.querySelector('[data-copy-label]');
        try {
          await navigator.clipboard.writeText(url);
          if (label) label.textContent = button.dataset.copiedLabel;
        } catch {
          if (navigator.share) {
            await navigator.share({ url }).catch(() => {});
          } else if (label) {
            label.textContent = url;
          }
        }
      });
    </script>
  </body>
</html>
